
from collections import deque

def water_jug(a, b, target):

    queue = deque([(0, 0)])
    visited = set()

    while queue:

        x, y = queue.popleft()

        if x == target or y == target:
            print("Solution Found:", x, y)
            return

        if (x, y) in visited:
            continue

        visited.add((x, y))

        states = [
            (a, y), (x, b),
            (0, y), (x, 0),
            (x - min(x, b-y), y + min(x, b-y)),
            (x + min(y, a-x), y - min(y, a-x))
        ]

        for state in states:
            if state not in visited:
                queue.append(state)

    print("No solution exists")

water_jug(4, 3, 2)
